# Optional: enter an international phone number (digits only) to request a
# pairing code instead of scanning a QR code. Example: 15551234567
PAIRING_PHONE_NUMBER=

# Directory where Baileys stores the sensitive linked-device session state.
AUTH_DIR=./auth

# How long to wait before reconnecting after a recoverable disconnect.
RECONNECT_DELAY_MS=5000

# Optional, used only in Baileys connection metadata.
WHATSAPP_BROWSER_NAME=Website Bridge

# The dashboard intentionally defaults to localhost. Put it behind an
# authenticated reverse proxy before making it reachable from the internet.
HOST=127.0.0.1
PORT=3000
TRACKED_GROUP_JIDS=120363429351723299@g.us
